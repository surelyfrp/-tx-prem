<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TX-PREM | FRP Tools & Reseller Portal</title>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
      background: #07111f;
      color: #f1f5f9;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    header {
      padding: 15px 20px;
      background: #0d1b2e;
      border-bottom: 1px solid #233650;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: relative;
    }

    .logo-container {
      text-align: left;
    }

    .logo {
      color: #38bdf8;
      font-size: 24px;
      font-weight: 900;
    }

    .logo span { color: #f8fafc; }

    header p {
      color: #94a3b8;
      font-size: 12px;
      margin-top: 2px;
    }

    .menu-btn {
      background: transparent;
      border: none;
      color: #38bdf8;
      font-size: 28px;
      cursor: pointer;
      display: none;
      padding: 5px 10px;
    }

    .nav-drawer {
      position: absolute;
      top: 100%;
      right: 0;
      width: 260px;
      background: #0d1b2e;
      border: 1px solid #233650;
      border-top: none;
      border-radius: 0 0 0 12px;
      display: none;
      flex-direction: column;
      z-index: 100;
      box-shadow: -5px 8px 15px rgba(0,0,0,0.5);
    }

    .nav-drawer.active {
      display: flex;
    }

    .nav-drawer button {
      background: transparent;
      color: #f1f5f9;
      text-align: left;
      padding: 14px 20px;
      border-bottom: 1px solid #1e2d42;
      border-radius: 0;
      font-size: 14px;
      font-weight: normal;
    }

    .nav-drawer button:hover {
      background: #172b40;
      color: #38bdf8;
    }

    main {
      width: 100%;
      max-width: 900px;
      margin: 0 auto;
      padding: 22px 15px 45px;
      flex: 1;
    }

    .hero {
      text-align: center;
      padding: 15px 5px;
    }

    .hero h1 {
      font-size: 26px;
      margin-bottom: 8px;
    }

    .hero h1 span { color: #38bdf8; }

    .hero p {
      color: #94a3b8;
      line-height: 1.5;
      font-size: 14px;
    }

    .panel, .card {
      background: #0d1b2e;
      border: 1px solid #233650;
      border-radius: 15px;
      padding: 20px;
      margin-bottom: 18px;
    }

    .tabs {
      display: flex;
      gap: 10px;
      margin-bottom: 20px;
    }

    .tabs button { flex: 1; }

    button {
      border: 0;
      padding: 12px;
      border-radius: 9px;
      background: #0284c7;
      color: white;
      font-size: 14px;
      font-weight: bold;
      cursor: pointer;
      transition: background 0.2s;
    }

    button:hover { background: #0369a1; }
    button.secondary { background: #233650; }
    button.secondary:hover { background: #334861; }
    button:disabled { opacity: 0.6; cursor: not-allowed; }

    input, select {
      display: block;
      width: 100%;
      margin: 8px 0 15px;
      padding: 12px;
      border-radius: 9px;
      border: 1px solid #334861;
      background: #07111f;
      color: white;
      font-size: 14px;
    }

    label {
      color: #cbd5e1;
      font-size: 13px;
    }

    .password-row {
      display: flex;
      gap: 8px;
      align-items: stretch;
      margin: 8px 0 15px;
    }

    .password-row input {
      flex: 1;
      margin: 0;
    }

    .toggle-password {
      min-width: 70px;
      padding: 10px;
      background: #233650;
      font-size: 12px;
    }

    h2 {
      margin-bottom: 15px;
      font-size: 20px;
      color: #f8fafc;
    }

    h3 { 
      margin-bottom: 10px; 
      color: #38bdf8;
    }

    .message {
      margin-top: 15px;
      padding: 12px;
      border-radius: 8px;
      background: #172b40;
      color: #bae6fd;
      line-height: 1.5;
      overflow-wrap: anywhere;
      font-size: 13px;
    }

    .hidden { display: none !important; }

    .balance {
      background: #102b3f;
      border: 1px solid #155e75;
      border-radius: 12px;
      padding: 18px;
      margin: 18px 0;
    }

    .credits {
      font-size: 32px;
      font-weight: bold;
      color: #38bdf8;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 15px;
    }

    .tool-card {
      display: flex;
      gap: 15px;
      align-items: flex-start;
      background: #0d1b2e;
      border: 1px solid #233650;
      border-radius: 12px;
      padding: 15px;
    }

    .tool-logo {
      width: 50px;
      height: 50px;
      object-fit: contain;
      border-radius: 8px;
      background: #07111f;
      padding: 4px;
      border: 1px solid #233650;
      flex-shrink: 0;
    }

    .tool-info {
      flex: 1;
    }

    .tool-info h3 {
      font-size: 16px;
      margin-bottom: 4px;
    }

    .tool-info p {
      color: #94a3b8;
      font-size: 12px;
      line-height: 1.4;
      margin-bottom: 8px;
    }

    .price-tag {
      font-weight: bold;
      color: #38bdf8;
      font-size: 13px;
      margin-bottom: 8px;
      display: block;
    }

    .small {
      color: #94a3b8;
      font-size: 12px;
      line-height: 1.5;
      margin-top: 10px;
    }

    .full-width { width: 100%; }

    .link-btn {
      background: none;
      border: none;
      color: #38bdf8;
      font-size: 13px;
      cursor: pointer;
      padding: 0;
      text-decoration: underline;
      margin-top: 5px;
    }

    .payment-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
      gap: 10px;
      margin: 12px 0 20px;
    }

    .pay-card {
      background: #07111f;
      border: 2px solid #233650;
      border-radius: 10px;
      padding: 10px 5px;
      text-align: center;
      cursor: pointer;
      transition: all 0.2s;
    }

    .pay-card:hover, .pay-card.selected {
      border-color: #38bdf8;
      background: #102b3f;
    }

    .pay-card img {
      width: 40px;
      height: 40px;
      object-fit: contain;
      margin-bottom: 5px;
      border-radius: 6px;
    }

    .pay-card span {
      display: block;
      font-size: 11px;
      font-weight: bold;
      color: #cbd5e1;
    }

    .tx-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 10px;
      font-size: 13px;
    }

    .tx-table th, .tx-table td {
      padding: 12px;
      text-align: left;
      border-bottom: 1px solid #1e2d42;
    }

    .tx-table th {
      background: #102b3f;
      color: #38bdf8;
    }

    .badge-pending {
      background: #854d0e;
      color: #fef08a;
      padding: 4px 8px;
      border-radius: 6px;
      font-size: 11px;
      font-weight: bold;
      display: inline-block;
    }

    .badge-success {
      background: #166534;
      color: #bbf7d0;
      padding: 4px 8px;
      border-radius: 6px;
      font-size: 11px;
      font-weight: bold;
      display: inline-block;
    }

    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(3, 10, 20, 0.88);
      backdrop-filter: blur(5px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1000;
      padding: 15px;
    }

    .modal-content {
      background: #0d1b2e;
      border: 1px solid #334861;
      border-radius: 16px;
      width: 100%;
      max-width: 520px;
      padding: 22px;
      max-height: 90vh;
      overflow-y: auto;
      box-shadow: 0 10px 25px rgba(0,0,0,0.7);
    }

    .currency-selector {
      display: flex;
      gap: 8px;
      margin-bottom: 8px;
    }

    .currency-selector button {
      flex: 1;
      padding: 8px;
      font-size: 12px;
      background: #172b40;
      border: 1px solid #334861;
      color: #94a3b8;
    }

    .currency-selector button.active {
      background: #0284c7;
      color: white;
      border-color: #38bdf8;
    }

    .copy-btn {
      background: #233650;
      color: #38bdf8;
      border: 1px solid #38bdf8;
      padding: 4px 8px;
      font-size: 11px;
      border-radius: 5px;
      cursor: pointer;
      margin-left: 8px;
    }

    .whatsapp-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: #25d366;
      color: #000;
      font-weight: bold;
      padding: 10px 16px;
      border-radius: 8px;
      text-decoration: none;
      margin-top: 10px;
      font-size: 13px;
    }

    footer {
      text-align: center;
      padding: 20px;
      color: #64748b;
      border-top: 1px solid #233650;
      font-size: 12px;
      background: #0d1b2e;
      margin-top: auto;
    }
  </style>
</head>
<body>

<header>
  <div class="logo-container">
    <div class="logo">TX-PREM <span>🚀</span></div>
    <p>FRP Tools & Reseller Portal</p>
  </div>
  
  <button id="menuBtn" class="menu-btn" onclick="toggleMenu()" aria-label="Toggle Navigation">☰</button>
  
  <nav id="navDrawer" class="nav-drawer">
    <button onclick="navigateTo('license')">1. Tool Licenses & Activations</button>
    <button onclick="navigateTo('account')">2. Account Settings</button>
    <button onclick="navigateTo('balance')">3. Credit Balance</button>
    <button onclick="navigateTo('tracker')">4. Live Transaction Status ⚡</button>
    <button onclick="navigateTo('rent')">5. Rent Tools</button>
    <button onclick="logout()" style="color: #f87171;">6. Log Out</button>
  </nav>
</header>

<main>
  <section class="hero">
    <h1>Welcome to <span>TX-PREM</span></h1>
    <p>Manage your reseller account, credit balance, and tool activations in one place.</p>
  </section>

  <!-- AUTH SECTION -->
  <section id="authSection" class="panel">
    <div id="authTabs" class="tabs">
      <button id="loginTab" type="button" onclick="showForm('login')">Login</button>
      <button id="registerTab" type="button" class="secondary" onclick="showForm('register')">Register</button>
    </div>

    <!-- LOGIN FORM -->
    <form id="loginForm">
      <h2>Sign In</h2>

      <label for="loginEmail">Email Address</label>
      <input id="loginEmail" type="email" placeholder="Enter your email" required autocomplete="email">

      <label for="loginPassword">Password</label>
      <div class="password-row">
        <input id="loginPassword" type="password" placeholder="Enter your password" required autocomplete="current-password">
        <button type="button" class="toggle-password" onclick="togglePassword('loginPassword', this)">Show</button>
      </div>

      <button id="loginButton" type="submit" class="full-width">Login</button>
      
      <div style="text-align: right; margin-top: 10px;">
        <button type="button" class="link-btn" onclick="showForm('forgot')">Forgot Password?</button>
      </div>
    </form>

    <!-- REGISTER FORM -->
    <form id="registerForm" class="hidden">
      <h2>Create Account</h2>

      <label for="regUsername">Username</label>
      <input id="regUsername" type="text" placeholder="Example: user123" minlength="3" maxlength="30" required autocomplete="username">

      <label for="regEmail">Email Address</label>
      <input id="regEmail" type="email" placeholder="Enter your email" required autocomplete="email">

      <label for="regPassword">Password (Min. 8 characters)</label>
      <div class="password-row">
        <input id="regPassword" type="password" placeholder="Create password" minlength="8" required autocomplete="new-password">
        <button type="button" class="toggle-password" onclick="togglePassword('regPassword', this)">Show</button>
      </div>

      <label for="regConfirmPassword">Confirm Password</label>
      <div class="password-row">
        <input id="regConfirmPassword" type="password" placeholder="Repeat password" minlength="8" required autocomplete="new-password">
        <button type="button" class="toggle-password" onclick="togglePassword('regConfirmPassword', this)">Show</button>
      </div>

      <button id="registerButton" type="submit" class="full-width">Create Account</button>
    </form>

    <!-- FORGOT PASSWORD FORM -->
    <form id="forgotForm" class="hidden">
      <h2>Reset Password Request</h2>
      <p class="small" style="margin-bottom: 15px;">Enter your registered Gmail / Email address below to receive the password reset link.</p>

      <label for="forgotEmail">Email Address</label>
      <input id="forgotEmail" type="email" placeholder="Enter your email address" required autocomplete="email">

      <button id="forgotButton" type="submit" class="full-width">Send Reset Link</button>
      
      <div style="text-align: center; margin-top: 15px;">
        <button type="button" class="link-btn" onclick="showForm('login')">Back to Login</button>
      </div>
    </form>

    <!-- NEW PASSWORD FORM -->
    <form id="resetPasswordForm" class="hidden">
      <h2>Set New Password</h2>
      <p class="small" style="margin-bottom: 15px;">Enter your new password below and confirm it to regain access.</p>

      <label for="newPassword">New Password (Min. 8 characters)</label>
      <div class="password-row">
        <input id="newPassword" type="password" placeholder="Enter new password" minlength="8" required>
        <button type="button" class="toggle-password" onclick="togglePassword('newPassword', this)">Show</button>
      </div>

      <label for="confirmNewPassword">Confirm New Password</label>
      <div class="password-row">
        <input id="confirmNewPassword" type="password" placeholder="Repeat new password" minlength="8" required>
        <button type="button" class="toggle-password" onclick="togglePassword('confirmNewPassword', this)">Show</button>
      </div>

      <button id="resetPasswordBtn" type="submit" class="full-width">Update Password & Login</button>
    </form>

    <div id="authMessage" class="message hidden"></div>
  </section>

