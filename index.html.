<script>
  const SUPABASE_URL = "https://ybhgxtnvemvqrysknvmp.supabase.co";
  const SUPABASE_KEY = "sb_publishable_5SrVUvBqMzzXHuKE8ph6cA_uZB_W2yj";

  let supabaseClient = null;
  let selectedMethod = "Tigo Pesa";
  let selectedCurrency = "USD";
  let baseUsdAmount = 0;
  let transactions = [];

  const authSection = document.getElementById("authSection");
  const dashboardSection = document.getElementById("dashboardSection");
  const authMessage = document.getElementById("authMessage");
  const dashboardMessage = document.getElementById("dashboardMessage");
  const menuBtn = document.getElementById("menuBtn");
  const navDrawer = document.getElementById("navDrawer");
  const paymentModal = document.getElementById("paymentModal");

  function showMessage(element, msg) {
    element.textContent = msg;
    element.classList.remove("hidden");
  }

  function hideMessage(element) {
    element.textContent = "";
    element.classList.add("hidden");
  }

  function togglePassword(inputId, btn) {
    const input = document.getElementById(inputId);
    const show = input.type === "password";
    input.type = show ? "text" : "password";
    btn.textContent = show ? "Hide" : "Show";
  }

  function toggleMenu() {
    navDrawer.classList.toggle("active");
  }

  function copyNumber(num) {
    navigator.clipboard.writeText(num);
    alert("Copied receiver number: " + num);
  }

  function showForm(formName) {
    hideMessage(authMessage);
    document.getElementById("loginForm").classList.toggle("hidden", formName !== "login");
    document.getElementById("registerForm").classList.toggle("hidden", formName !== "register");
    document.getElementById("forgotForm").classList.toggle("hidden", formName !== "forgot");
    document.getElementById("resetPasswordForm").classList.toggle("hidden", formName !== "reset");
    
    document.getElementById("authTabs").classList.toggle("hidden", formName === "reset" || formName === "forgot");
    if(formName === 'login' || formName === 'register') {
      document.getElementById("loginTab").classList.toggle("secondary", formName !== "login");
      document.getElementById("registerTab").classList.toggle("secondary", formName !== "register");
    }
  }

  function navigateTo(sectionName) {
    navDrawer.classList.remove("active");
    const sections = document.querySelectorAll(".nav-section");
    sections.forEach(s => s.classList.add("hidden"));

    const target = document.getElementById(sectionName + "Section");
    if (target) target.classList.remove("hidden");
  }

  function openPaymentModal(serviceTitle, usdPrice = 5) {
    document.getElementById("paymentModalTitle").textContent = "Payment for: " + serviceTitle;
    baseUsdAmount = usdPrice;
    selectedCurrency = "USD";
    
    // Reset Currency Buttons UI
    document.querySelectorAll(".currency-selector button").forEach(b => b.classList.remove("active"));
    document.querySelectorAll(".currency-selector button")[0].classList.add("active");

    document.getElementById("payAmount").value = baseUsdAmount;
    paymentModal.classList.remove("hidden");
  }

  function closePaymentModal() {
    paymentModal.classList.add("hidden");
  }

  function selectPaymentMethod(element, methodName) {
    document.querySelectorAll(".pay-card").forEach(card => card.classList.remove("selected"));
    element.classList.add("selected");
    selectedMethod = methodName;
  }

  function setCurrency(curr, btn) {
    document.querySelectorAll(".currency-selector button").forEach(b => b.classList.remove("active"));
    btn.classList.add("active");
    selectedCurrency = curr;

    const amountInput = document.getElementById("payAmount");
    if(curr === "USD") {
      amountInput.value = baseUsdAmount;
    } else if(curr === "TSH") {
      amountInput.value = Math.round(baseUsdAmount * 2600);
    } else if(curr === "KSH") {
      amountInput.value = Math.round(baseUsdAmount * 130);
    } else if(curr === "UGX") {
      amountInput.value = Math.round(baseUsdAmount * 3700);
    }
  }

  function renderTransactions() {
    const tbody = document.getElementById("txTableBody");
    if (transactions.length === 0) {
      tbody.innerHTML = '<tr><td colspan="5" style="text-align: center; color: #94a3b8;">No recent transactions found.</td></tr>';
      return;
    }

    tbody.innerHTML = transactions.map(tx => `
      <tr>
        <td><strong>${tx.id}</strong></td>
        <td>${tx.item}</td>
        <td>${tx.method}</td>
        <td>${tx.amount} ${tx.currency}</td>
        <td>
          <span class="${tx.status === 'SUCCESS' ? 'badge-success' : 'badge-pending'}">
            ${tx.status === 'PENDING' ? '⏳ PENDING (Awaiting PIN)' : '✅ SUCCESS'}
          </span>
        </td>
      </tr>
    `).join("");
  }

  document.getElementById("paymentForm").addEventListener("submit", (e) => {
    e.preventDefault();
    const serviceName = document.getElementById("paymentModalTitle").textContent.replace("Payment for: ", "");
    const amount = document.getElementById("payAmount").value.trim();
    const refId = "TX-" + Math.floor(100000 + Math.random() * 900000);

    const newTx = {
      id: refId,
      item: serviceName,
      method: selectedMethod,
      amount: amount,
      currency: selectedCurrency,
      status: "PENDING"
    };

    transactions.unshift(newTx);
    renderTransactions();
    closePaymentModal();

    navigateTo("tracker");

    alert(
      "✅ PAYMENT PROMPT DISPATCHED TO PHONE!\n\n" +
      "Ref ID: " + refId + "\n" +
      "Service: " + serviceName + "\n" +
      "Method: " + selectedMethod + "\n" +
      "Amount: " + amount + " " + selectedCurrency + "\n\n" +
      "🔐 Please enter your SECRET PIN on your mobile phone screen now to confirm payment to +255628354099."
    );

    setTimeout(() => {
      newTx.status = "SUCCESS";
      renderTransactions();
    }, 12000);
  });

  async function startApp() {
    try {
      if (!window.supabase) return;
      supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

      supabaseClient.auth.onAuthStateChange((event, session) => {
        if (event === "PASSWORD_RECOVERY") {
          authSection.classList.remove("hidden");
          dashboardSection.classList.add("hidden");
          showForm("reset");
          showMessage(authMessage, "Please set and confirm your new password below.");
        } else if (session) {
          showDashboard(session.user);
        } else {
          showLogin();
        }
      });

      const { data } = await supabaseClient.auth.getSession();
      if (data && data.session) showDashboard(data.session.user);

    } catch (err) {
      console.log("Supabase Init Error:", err.message);
    }
  }

  function showDashboard(user) {
    authSection.classList.add("hidden");
    dashboardSection.classList.remove("hidden");
    menuBtn.style.display = "block";
    document.getElementById("dashAccountEmail").textContent = user.email || "";
    loadProfile(user);
    renderTransactions();
  }

  function showLogin() {
    dashboardSection.classList.add("hidden");
    authSection.classList.remove("hidden");
    menuBtn.style.display = "none";
    navDrawer.classList.remove("active");
    showForm("login");
  }

  document.getElementById("loginForm").addEventListener("submit", async (e) => {
    e.preventDefault();
    hideMessage(authMessage);
    const email = document.getElementById("loginEmail").value.trim();
    const password = document.getElementById("loginPassword").value;

    if(!supabaseClient) {
      showMessage(authMessage, "Supabase connection error.");
      return;
    }

    try {
      const { data, error } = await supabaseClient.auth.signInWithPassword({ email, password });
      if (error) throw error;
      showDashboard(data.user);
    } catch (err) {
      showMessage(authMessage, "Login failed: " + err.message);
    }
  });

  document.getElementById("registerForm").addEventListener("submit", async (e) => {
    e.preventDefault();
    hideMessage(authMessage);

    const username = document.getElementById("regUsername").value.trim();
    const email = document.getElementById("regEmail").value.trim();
    const password = document.getElementById("regPassword").value;
    const confirmPass = document.getElementById("regConfirmPassword").value;

    if (password !== confirmPass) {
      showMessage(authMessage, "Passwords do not match. Please verify and try again.");
      return;
    }

    if(!supabaseClient) {
      showMessage(authMessage, "Supabase connection error.");
      return;
    }

    try {
      const { data, error } = await supabaseClient.auth.signUp({
        email, password, options: { data: { username } }
      });
      if (error) throw error;
      
      if(data.session) {
        showDashboard(data.user);
      } else {
        showMessage(authMessage, "Registration successful! Please check your Gmail to confirm your email.");
      }
    } catch (err) {
      showMessage(authMessage, "Registration failed: " + err.message);
    }
  });

  document.getElementById("forgotForm").addEventListener("submit", async (e) => {
    e.preventDefault();
    hideMessage(authMessage);
    const email = document.getElementById("forgotEmail").value.trim();

    if(!supabaseClient) return;

    try {
      const { error } = await supabaseClient.auth.resetPasswordForEmail(email, {
        redirectTo: window.location.href
      });
      if (error) throw error;
      showMessage(authMessage, "A password reset link has been sent to your Gmail/Email address.");
    } catch (err) {
      showMessage(authMessage, "Error: " + err.message);
    }
  });

  document.getElementById("resetPasswordForm").addEventListener("submit", async (e) => {
    e.preventDefault();
    hideMessage(authMessage);

    const newPassword = document.getElementById("newPassword").value;
    const confirmNewPassword = document.getElementById("confirmNewPassword").value;

    if (newPassword !== confirmNewPassword) {
      showMessage(authMessage, "Passwords do not match.");
      return;
    }

    try {
      const { error } = await supabaseClient.auth.updateUser({ password: newPassword });
      if (error) throw error;
      
      showMessage(authMessage, "Password updated successfully! Redirecting...");
      setTimeout(() => {
        showForm("login");
      }, 1500);

    } catch (err) {
      showMessage(authMessage, "Failed to update password: " + err.message);
    }
  });

  async function loadProfile(user) {
    if(!supabaseClient) return;
    try {
      const { data, error } = await supabaseClient
        .from("reseller_profiles")
        .select("username, credits")
        .eq("id", user.id)
        .single();

      if (error) throw error;
      document.getElementById("userCredits").textContent = Number(data.credits || 0).toLocaleString("en-US");
      if(data.username) document.getElementById("updateUsername").value = data.username;
    } catch (err) {
      document.getElementById("userCredits").textContent = "0.00";
    }
  }

  document.getElementById("updateProfileForm").addEventListener("submit", async (e) => {
    e.preventDefault();
    hideMessage(dashboardMessage);
    const username = document.getElementById("updateUsername").value.trim();

    try {
      const { data: { user } } = await supabaseClient.auth.getUser();
      const { error } = await supabaseClient
        .from("reseller_profiles")
        .update({ username })
        .eq("id", user.id);

      if (error) throw error;
      showMessage(dashboardMessage, "Username updated successfully!");
    } catch (err) {
      showMessage(dashboardMessage, "Failed to update username: " + err.message);
    }
  });

  document.getElementById("changePasswordForm").addEventListener("submit", async (e) => {
    e.preventDefault();
    hideMessage(dashboardMessage);
    const newPassword = document.getElementById("changePassCurrent").value;

    try {
      const { error } = await supabaseClient.auth.updateUser({ password: newPassword });
      if (error) throw error;
      showMessage(dashboardMessage, "Password changed successfully!");
      document.getElementById("changePasswordForm").reset();
    } catch (err) {
      showMessage(dashboardMessage, "Failed to change password: " + err.message);
    }
  });

  async function logout() {
    if (supabaseClient) await supabaseClient.auth.signOut();
    showLogin();
  }

  startApp();
</script>
